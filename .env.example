# Somente no servidor. Nunca coloque estas chaves no frontend.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Legacy service_role JWT: Supabase > Settings > API Keys > Legacy keys
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bagres-player-photos
# Gere ambos com npm run admin:credentials; não use valores de exemplo.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_KEY=
